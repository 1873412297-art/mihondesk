CREATE TABLE sync_state(
    device_id TEXT NOT NULL PRIMARY KEY,
    last_push_cursor INTEGER NOT NULL DEFAULT 0,
    last_pull_cursor INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0,
    sync_clock INTEGER NOT NULL DEFAULT 0
);

DROP TRIGGER IF EXISTS update_last_modified_at_mangas;
CREATE TRIGGER update_last_modified_at_mangas
AFTER UPDATE ON mangas
FOR EACH ROW
WHEN new.is_syncing = 0 AND old.is_syncing = 0 AND new.last_modified_at = old.last_modified_at
BEGIN
  UPDATE mangas
  SET last_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;

DROP TRIGGER IF EXISTS update_last_modified_at_chapters;
CREATE TRIGGER update_last_modified_at_chapters
AFTER UPDATE ON chapters
FOR EACH ROW
WHEN new.is_syncing = 0 AND old.is_syncing = 0 AND new.last_modified_at = old.last_modified_at
BEGIN
  UPDATE chapters
  SET last_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;

